# SkillBridge Environment Configuration

# Flask secret key — change this in production
SECRET_KEY=your-secret-key-change-in-production

# Database URL — supports MySQL, PostgreSQL, or SQLite
# MySQL (recommended for production):
#   DATABASE_URL=mysql+pymysql://root:password@localhost/skillbridge?charset=utf8mb4
# PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost/skillbridge
# SQLite (development fallback, no env var needed):
#   DATABASE_URL=sqlite:///instance/skillbridge.db
DATABASE_URL=mysql+pymysql://root:password@localhost/skillbridge?charset=utf8mb4

# YouTube Data API v3 key (optional — fallback curated videos used otherwise)
YOUTUBE_API_KEY=

# OpenAI API key (optional — fallback rule-based AI used otherwise)
OPENAI_API_KEY=

# Flask environment
FLASK_ENV=development

# Redis URL (optional — for SocketIO)
REDIS_URL=
